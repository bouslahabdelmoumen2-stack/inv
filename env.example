# Copy this file to ".env" for local testing only (Vercel CLI reads .env automatically).
# For an actual deployment, set this same variable in your hosting dashboard instead —
# see README.md -> "Deploy safely" section.
# Replace the placeholder below with your real key ONLY in your local .env (which is
# git-ignored) or in your hosting provider's dashboard — never commit the real value.

CHARGILY_SECRET_KEY=paste_your_chargily_secret_key_here
